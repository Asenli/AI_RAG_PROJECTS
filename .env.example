# ============================================================
#  食安团餐售后智能助手 — 环境变量配置模板
#  复制此文件为 .env 并填写实际值:
#    cp .env.example .env
# ============================================================

# ===== LLM: DeepSeek 官方 API =====
# 用于生成最终回答；不要把真实 Key 提交到代码仓库
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ===== SiliconFlow API (Embedding + Rerank) =====
# 用于 BAAI/bge-large-zh-v1.5 embedding 和 BAAI/bge-reranker-v2-m3 rerank
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key

# ===== Multi-tenant =====
DEFAULT_COMPANY_ID=1
COMPANY_ID=1

# ===== PostgreSQL =====
PG_DB=food_safety
PG_USER=postgres
PG_PASSWORD=change-me-postgres-password

# ===== Redis =====
REDIS_PASSWORD=change-me-redis-password

# ===== MinIO（对象存储） =====
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET=knowledge-base

# ===== Docker service ports =====
FRONTEND_PORT=5001
BACKEND_PORT=5002

# ===== Backend runtime =====
# 小服务器建议 1-2；4C/8G 可设置为 2-4
WEB_CONCURRENCY=2

# ===== Host mount paths (optional) =====
# 默认按当前仓库布局使用 ./knowledge_base 和 ../data
# 服务器上目录不同就改成绝对路径，例如 /opt/food-safety/knowledge_base
# KB_PATH=./knowledge_base
# DATA_PATH=../data

# ===== JWT =====
# 生成方式: openssl rand -base64 64
JWT_SECRET=change-me-in-production-use-a-strong-random-string
